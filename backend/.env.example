# EventSphere Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Leave empty to automatically use high-performance embedded in-memory MongoDB
# Or provide local/Atlas URI: mongodb://localhost:27017/eventsphere
MONGODB_URI=

# JWT Authentication
JWT_SECRET=eventsphere_super_secret_jwt_key_2026_dev
JWT_EXPIRES_IN=7d

# Redis / BullMQ (Optional: in-memory queue fallback active when empty)
REDIS_URL=

# Frontend Base URL
FRONTEND_URL=http://localhost:5173

# Email / SMTP (Optional: Ethereal test account automatically provisioned when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EventSphere" <notifications@eventsphere.io>

# Cloudinary (Optional: local file storage active by default)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
