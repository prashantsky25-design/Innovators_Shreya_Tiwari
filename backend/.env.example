# Server Port (Render sets this automatically)
PORT=10000
NODE_ENV=production

# MongoDB Database URI (From MongoDB Atlas - https://cloud.mongodb.com)
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/elevate?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret (Render can generate this automatically or supply 32+ char secret)
JWT_SECRET=elevate_super_secure_production_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=https://elevate-platform.onrender.com

# Optional: Google OAuth 2.0 Credentials (for "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Custom SMTP Email Notifications (Defaults to automatic test emailer if blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Elevate" <notifications@elevate.io>

# Optional: Cloudinary Storage (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
