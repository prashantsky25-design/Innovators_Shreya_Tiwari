# Backend API URL (Set this in Vercel to connect to your Render backend)
VITE_API_URL=https://elevate-backend.onrender.com

# Firebase Client SDK Configuration (Get these from Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
